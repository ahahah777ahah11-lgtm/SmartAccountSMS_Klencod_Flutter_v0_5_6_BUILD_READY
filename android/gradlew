#!/usr/bin/env sh
# Lightweight Gradle launcher for hosted Linux builders without a checked-in wrapper JAR.
set -eu
GRADLE_VERSION="8.14.3"
GRADLE_HOME_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/smartaccount-gradle-${GRADLE_VERSION}"
GRADLE_BIN="$GRADLE_HOME_DIR/gradle-${GRADLE_VERSION}/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$GRADLE_HOME_DIR"
  ARCHIVE="$GRADLE_HOME_DIR/gradle-${GRADLE_VERSION}-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$ARCHIVE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ARCHIVE" "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
  else
    echo "curl or wget is required to download Gradle" >&2; exit 1
  fi
  unzip -q -o "$ARCHIVE" -d "$GRADLE_HOME_DIR"
  rm -f "$ARCHIVE"
fi
exec "$GRADLE_BIN" "$@"
